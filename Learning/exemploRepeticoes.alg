algoritmo "Repitições"

var

i: inteiro

inicio

i <- 0

enquanto (i < 10 ) faca 
// é usado dependendo de alguma coisa 1 - em que momento acontece o teste e 2 - a quantidade de vezes que será repetida. 
// ele so ira repetir o codigo enquanto a função for verdadeira ( não tenho controle na quantidade de vezes que será repetido).
// teste priori
// sem número de repetições mínimas, número ideterminado de repetições
escreval(i) 

i <- i + 1 // incremento, isso é, toda vez que ele repetir a estrutura enquanto i ganhara + 1 no seu valor 
// ate o i se tornar 10
fimenquanto
fimalgoritmo

