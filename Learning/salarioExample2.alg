algoritmo "Salario"

var

salario: real
setor: caractere
test: logico

inicio

salario <- 1000
setor <- "ADM"
test <- salario <= 1000 ou setor = "ADM"
escreval(test)
test <- salario <= 1000 ou setor = "adm"
escreval(test)
test <- salario < 1000 ou setor = "ADM"
escreval(test)
test <- salario < 1000 ou setor = "adm"
escreval(test)
fimalgoritmo