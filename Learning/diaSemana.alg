algoritmo "Dia da semana"

var

dia: caractere

inicio

escreva("Digite um dia da semana: ")
leia(dia)

escolha dia

    caso "segunda"

escreva("Pior dia da semana!!")

    caso "terça"

escreva("Segundo pior dia!!")

    caso "quarta"

escreva("ta melhorando")

    caso "quinta"

escreva("AMANHA É SEXTAAAAAA!!!!!!!!!!")

    caso "sexta"

escreva("Melhor dia da semana")

    caso "sabado"

escreva(" Sabadou bb'sss")

    caso "domingo"

escreva(" amanha volta a rotina :(")

    outrocaso

escreva("Dia invalido")
fimescolha


fimalgoritmo