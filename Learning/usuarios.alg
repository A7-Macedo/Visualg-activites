algoritmo "Usuarios" 
// inicio de um algoritmo/programa!
// com declaração propria

var 
// declaração de variáveis

nomeCompleto: caractere 
// variaveis definida como uma classe, mas existem outras classes: 
username: caractere
password: caractere
idade: inteiro  
// reais, inteiro, cadeia, logica, caracter 
peso: real
ativo: logico

inicio // inicio do programa 

// você declara qual o valor de cada variavel

nomeCompleto <- "Arthur Cortasio Macedo" //                                                     =============================================================================
idade <- 16 //                                                                                  =============================================================================
peso <- 53.5 //                                                                                 =============================================================================
username <-"A7-Macedo" //                                                                       ================== Parte que irá rodar o codigo =============================
password <- "Arthur123" //                                                                      =============================================================================
ativo <- verdadeiro   //                                                                        =============================================================================
                                                               

escreval(nomeCompleto) //  escreval == pule uma linha pos escreva                               =============================================================================
escreval(idade) //         escreva == mesma linha                                               =============================================================================
escreval(peso) //                                                                               ==============================Parte que será exibida========================
escreval(username) //                                                                           =============================================================================
escreval(password) //                                                                           =============================================================================
escreval(ativo) //                                                                              =============================================================================


fimalgoritmo // Finalzação do algoritmo/programa!