algoritmo "Salario"

var

salario: real


inicio

salario <- 1000
escreval("salario > 500: ", salario > 500)
escreval("salario > 500: ", salario>=500)
escreval("salario < 500: ", salario<500)
escreval("salario <= 500: ", salario<=500)
escreval("salario = 500: ", salario = 500)
escreval("salario <> 500: ", salario <> 500)
fimalgoritmo