algoritmo "Produto mais barato"

var

n1: inteiro
n2: inteiro

inicio

escreva("Qual é o valor do primeiro produto: ")
leia(n1)
escreva("Qual é o valor do segundo produto: ")
leia(n2)

se ( n1 > n2) entao
escreva("o segundo produto é mais barato")
senao se (n2 > n1) entao
escreva("O primeiro produto é mais barato")
senao
escreva("Os dois tem o mesmo preço")
fimse
fimse

fimalgoritmo