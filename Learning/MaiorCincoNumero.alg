algoritmo "Nome do Programa"

var

n1, n2, n3, n4, n5: real

inicio

escreva("Digite o primeiro número: ")
leia(n1)
escreva("Digite o segundo número: ")
leia(n2)
escreva("Digite o terceiro número: ")
leia(n3)
escreva("Digite o quarto número: ")
leia(n4)
escreva("Digite o quinto número: ")
leia(n5)

se (n1 > n2) e (n1 > n3) e (n1 > n4) e (n1 > n5) entao

escreva("O primeiro número é o maior!")

senao se (n2 > n1) e (n2 > n3) e (n2 > n4) e (n2 > n5) entao

escreva("O segundo número é o maior!")

senao se (n3 > n1) e (n3 > n2) e (n3 > n4) e (n3 > n5) entao

escreva("O terceiro número é o maior!")

senao se (n4 > n1) e (n1 > n2) e (n1 > n3) e (n1 > n5) entao

escreva("O quarto número é o maior!")
senao se (n5 > n2) e (n5 > n3) e (n5 > n4) e (n5 > n1)  entao

escreva("O quinto número é o maior!")

fimse
fimse
fimse
fimse
fimse
fimalgoritmo