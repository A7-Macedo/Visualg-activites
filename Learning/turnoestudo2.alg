algoritmo ""
var
turno:caractere

inicio
escreval("Digite m para matutino. digite v para vespertino ou n para noturno")
leia(turno)

se turno = "v" entao
    escreval ("boa tarde")
senao se (turno = "m") entao
    escreval ("bom dia")
senao se (turno = "n") entao
    escreval ("boa noite")
fimse
fimse
fimse
fimalgoritmo
