algoritmo "Maior Dois Numeros"

var

n1, n2: real

inicio

escreva("Digite o primeiro número: ")
leia(n1)
escreva("Digite o segundo número ")
leia(n2)

se (n1 > n2) entao
escreva("O primeiro número é maior")
senao se (n2 > n1) entao
escreva("O segundo número é maior")

// você nao pediu pra exibir nada se eles forem iguais

fimse
fimse
fimalgoritmo

