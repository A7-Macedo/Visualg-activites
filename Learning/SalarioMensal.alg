algoritmo "Salario Mensal"

var

ganho, horas, salario: real

inicio

escreva("Digite quanto o funcionario ganha por hora: ")
leia(ganho)
escreva("Digite quantas horas o funcionario trabalha por mês: ")
leia(horas)

salario <- ganho * horas

escreva("O seu funcionario ganha R$:", salario, " por mês")

fimalgoritmo